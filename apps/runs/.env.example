# Copy this file to .env and fill in the values from
# https://www.strava.com/settings/api (after authorizing your app with the
# activity:read_all scope so private/all runs are included).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Optional overrides
# How many trailing days of activities to sync.
STRAVA_SYNC_DAYS=365
# Distance (km) at/above which a run is flagged "long" in the UI.
LONG_RUN_KM=12
